<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="it.polimi.ingsw.GUI.Controllers.ShipBuilderController">
    <center>
        <AnchorPane fx:id="anchorPane" prefWidth="937" prefHeight="679" minWidth="937" minHeight="679" maxWidth="937" maxHeight="679">
        </AnchorPane>
    </center>
    
    <bottom>
        <VBox spacing="10" alignment="CENTER">
            <Label fx:id="statusLabel" text="Ready - Pick a component to start" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            
            <HBox alignment="CENTER" spacing="20">
                <Label text="Selected card:"/>
                <ImageView fx:id="cardImage" fitWidth="80" fitHeight="80" preserveRatio="true"/>
                <Button fx:id="pickComponentButton" text="Pick Component" onAction="#pickComponent"/>
                <Button fx:id="rotateClockwiseButton" text="Rotate Clockwise" onAction="#rotateCardClockwise"/>
                <Button fx:id="rotateCounterClockwiseButton" text="Rotate Counter-clockwise" onAction="#rotateCardAntiClockwise"/>
                <Button fx:id="restoreCompButton" text="Restore component" onAction="#RestoreSelectedStashedComp"/>
                <Button fx:id="validateShipButton" text="Validate Ship" onAction="#validateShip"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>