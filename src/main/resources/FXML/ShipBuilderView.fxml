<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import javafx.scene.image.ImageView?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="it.polimi.ingsw.GUI.Controllers.ShipBuilderController" prefWidth="900" prefHeight="700">
<!-- Main board section -->
<center>
    <AnchorPane fx:id="boardPane" prefWidth="1200" prefHeight="1200"
                style="-fx-background-image: url('Images/cardboard/cardboard-1b.jpg'); -fx-background-size: contain; -fx-background-repeat: no-repeat; -fx-background-position: center;">
    </AnchorPane>
</center>
<!-- Bottom card section -->
<bottom>
    <HBox alignment="CENTER" spacing="20">
        <Label text="Selected card:"/>
        <ImageView fx:id="cardImage" fitWidth="80" fitHeight="80"/>
        <Button text="Pick Component" onAction="#pickComponent"/>
        <Button text="Rotate clockwise" onAction="#rotateCardClockwise"/>
        <Button text="Rotate anticlockwise" onAction="#rotateCardAntiClockwise"/>
    </HBox>
</bottom>
</BorderPane>