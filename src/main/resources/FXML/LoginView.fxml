<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="it.polimi.ingsw.GUI.Controllers.LoginController" stylesheets="@loginStyle.css">

    <VBox alignment="CENTER" spacing="15" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0"
          AnchorPane.topAnchor="50.0" AnchorPane.bottomAnchor="50.0">
        <Label text="Login Page" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <VBox spacing="10" alignment="CENTER">
            <Label text="Enter your connection details:"/>
            <TextField fx:id="usernameField" promptText="Username" prefWidth="250"/>
            <TextField fx:id="connTypeField" promptText="Connection Type (socket/rmi)" prefWidth="250"/>
            <TextField fx:id="ipAddrField" promptText="Server Address (localhost)" prefWidth="250"/>
            <TextField fx:id="srvPortField" promptText="Server Port (7777 for socket, 1099 for rmi)" prefWidth="250"/>
        </VBox>

        <Button text="Connect" onAction="#handleLogin" prefWidth="150" style="-fx-font-size: 14px;"/>
    </VBox>

</AnchorPane>